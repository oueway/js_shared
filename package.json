{
  "name": "@oueway/js-shared",
  "version": "1.0.10",
  "description": "Reusable authentication and dashboard components for Supabase-powered Next.js apps",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.mts",
      "import": "./dist/index.mjs"
    },
    "./components": {
      "types": "./dist/components/index.d.mts",
      "import": "./dist/components/index.mjs"
    },
    "./lib": {
      "types": "./dist/lib/index.d.mts",
      "import": "./dist/lib/index.mjs"
    },
    "./pages": {
      "types": "./dist/pages/index.d.mts",
      "import": "./dist/pages/index.mjs"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "clean": "rm -rf dist",
    "prepare": "pnpm build",
    "release": "pnpm version patch && git push && git push --tags"
  },
  "keywords": [
    "supabase",
    "authentication",
    "dashboard",
    "nextjs",
    "react"
  ],
  "peerDependencies": {
    "@supabase/ssr": ">=0.8.0",
    "lucide-react": ">=0.400.0",
    "next": "16.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.95.3",
    "@types/react": "^18.3.28",
    "eslint": "^9.39.2",
    "globals": "^17.3.0",
    "lucide-react": "^0.400.0",
    "next": "16.0.10",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.55.0"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "dependencies": {
    "@marsidev/react-turnstile": "^1.4.2"
  }
}
